{
  "name": "authenticated-sessions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Launch Browserbase sessions that sign in with 1Password and reuse that login through a persisted context.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "mcp": "tsx src/mcp.ts",
    "http": "tsx src/http.ts",
    "smoke": "tsx src/cli.ts smoke",
    "login": "tsx src/cli.ts login",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@1password/sdk": "^0.5.0",
    "@browserbasehq/sdk": "^2.21.0",
    "@browserbasehq/stagehand": "^4.1.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
