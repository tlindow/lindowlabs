# Auth.js / Google sign-in for the private /learning dashboard.
# Required on Vercel for Google OAuth. Builds succeed without these;
# /learning then shows "Sign-in not configured yet".
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional. Auth.js infers the host on Vercel when trustHost is true.
# AUTH_URL=https://lindowlabs.dev

# Local screenshots only. Never set this on Vercel production.
# LEARNING_AUTH_BYPASS=1
