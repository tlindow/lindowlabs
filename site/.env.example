# Stytch auth for the private /learning dashboard (same project as Tinker).
# Copy STYTCH_* from the beginner-work/tinker Vercel project.
# Builds succeed without them; /learning then shows "Sign-in not configured yet".
STYTCH_PROJECT_ID=
STYTCH_SECRET=

# Owner of the personalized curriculum (server-side only). Any valid phone can
# OTP sign in; only the owner account sees Tyler's reading list / essay quotes.
# Prefer LEARNING_OWNER_PHONES. LEARNING_ALLOWED_PHONES is still read as a
# fallback so existing Vercel env keeps working (no new secret required).
# Optional: LEARNING_OWNER_USER_IDS=user-live-... (Stytch user_id list)
# Example (Tyler's number only — never hardcode in source):
LEARNING_OWNER_PHONES=+16505805788
# LEARNING_ALLOWED_PHONES=+16505805788

# Notion Reading plan (server-only). Create an internal integration with
# "Read content" only, then share it to the Reading plan page alone.
NOTION_READING_PLAN_TOKEN=
# Defaults to the Lindow Labs Reading plan page when unset:
# NOTION_READING_PLAN_PAGE_ID=3f049cb4-8293-8124-82e8-f6e2aa6fc21e

# Local screenshots only. Never set these on Vercel production.
# LEARNING_AUTH_BYPASS=1
# LEARNING_AUTH_BYPASS_OWNER=0   # non-owner empty desk screenshot
# LEARNING_CURRICULUM_FIXTURE=1

# Playlist progress currently uses an httpOnly cookie (ll_learning_playlist_v1)
# keyed by Stytch user_id. For durable multi-device storage, add Vercel KV /
# Upstash Redis and wire site/src/app/api/learning/playlist-progress/route.ts.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
