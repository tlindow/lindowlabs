# Stytch auth for the private /learning dashboard (same project as Tinker).
# Copy these from the beginner-work/tinker Vercel project.
# Builds succeed without them; /learning then shows "Sign-in not configured yet".
STYTCH_PROJECT_ID=
STYTCH_SECRET=

# Local screenshots only. Never set this on Vercel production.
# LEARNING_AUTH_BYPASS=1
