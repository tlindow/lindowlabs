{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-resume-data.mjs && (node scripts/watch-resume.mjs & next dev)",
    "build": "node scripts/sync-resume-data.mjs && next build && node scripts/write-redirects.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:client-imports && npm run check:em-dashes -- --source && npm run build && npm run check:labels && npm run check:em-dashes && npm run check:locations",
    "check:em-dashes": "node scripts/check-em-dashes.mjs",
    "check:client-imports": "node scripts/check-client-imports.mjs",
    "check:labels": "node scripts/verify-labeled-paragraphs.mjs",
    "check:locations": "node scripts/check-locations.mjs",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint",
    "remove-bg": "node scripts/remove-bg.mjs",
    "generate:slides": "node scripts/generate-slides.mjs",
    "export:pdf": "node scripts/sync-resume-gdrive.mjs --pdf-only",
    "sync:gdrive": "node scripts/sync-resume-gdrive.mjs",
    "export:gdoc": "node scripts/export-resume-gdoc.mjs --local-only",
    "sync:gdoc": "node scripts/export-resume-gdoc.mjs"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "dotenv": "^17.4.2",
    "firebase": "^12.18.0",
    "framer-motion": "^12.35.0",
    "googleapis": "^176.0.0",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "puppeteer": "^25.9.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
