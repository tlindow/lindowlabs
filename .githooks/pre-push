#!/usr/bin/env bash
# Pre-push gate (installed by `npm install` in site/ via core.hooksPath).
#
# Always runs the fast tier of site/scripts/check.mjs. Runs the full pipeline
# (build + artifact + browser) when the pushed commits touch site/ or
# docs/loop-log.md. Same manifest as `npm run check` and PR CI.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
site_dir="${repo_root}/site"
zero="0000000000000000000000000000000000000000"

if [ ! -d "${site_dir}/node_modules" ]; then
  echo "pre-push: site/node_modules missing. Run: cd site && npm ci" >&2
  exit 1
fi

full=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "${local_sha}" = "${zero}" ] && continue # branch delete
  if [ "${remote_sha}" = "${zero}" ]; then
    base="$(git merge-base "${local_sha}" origin/main 2>/dev/null || true)"
  else
    base="${remote_sha}"
  fi
  if [ -z "${base}" ] || ! git cat-file -e "${base}^{commit}" 2>/dev/null; then
    full=1 # unknown base: be safe
    continue
  fi
  if git diff --name-only "${base}" "${local_sha}" -- site docs/loop-log.md | grep -q .; then
    full=1
  fi
done

cd "${site_dir}"
if [ "${full}" = "1" ]; then
  echo "pre-push: site/ changed, running full pipeline (npm run check)"
  node scripts/check.mjs
else
  echo "pre-push: no site/ changes, running fast tier"
  node scripts/check.mjs --tier fast
fi
